 "html": "\r\n{% if doc.status != \"Approved\" and doc.status != \"Reimbursed\" %}\r\n        PENDING APPROVAL \u2014 NOT YET REIMBURSABLE\r\n{% endif %}\r\n\r\n\r\n<h1>Expense Claim Voucher</h1>\r\n\r\n\r\n<h3>Employee and Department</h3>\r\n\r\n<table>\r\n    <tr>\r\n        <td><strong>Employee</strong></td>\r\n        <td>{{ doc.employee }}</td>\r\n    </tr>\r\n\r\n    <tr>\r\n        <td><strong>Department</strong></td>\r\n        <td>{{ doc.department }}</td>\r\n    </tr>\r\n\r\n    <tr>\r\n        <td><strong>Budget</strong></td>\r\n        <td>{{ doc.budget }}</td>\r\n    </tr>\r\n\r\n    <tr>\r\n        <td><strong>Expense Date</strong></td>\r\n        <td>{{ doc.expense_date }}</td>\r\n    </tr>\r\n\r\n    <tr>\r\n        <td><strong>Status</strong></td>\r\n        <td>{{ doc.status }}</td>\r\n    </tr>\r\n</table>\r\n\r\n\r\n{% set department_name = frappe.db.get_value(\r\n    \"Department\",\r\n    doc.department,\r\n    \"department_name\"\r\n) %}\r\n\r\n<p>\r\n    <strong>Department Name:</strong>\r\n    {{ department_name }}\r\n</p>\r\n\r\n\r\n<h3>Expense Lines</h3>\r\n\r\n<style>\r\n    .exp-line {\r\n        display: flex;\r\n        gap: 20px;\r\n        align-items: center;\r\n    }\r\n</style>\r\n\r\n{% for x in doc.expense_line %}\r\n\r\n<div class=\"exp-line\">\r\n    <p>\r\n        <strong>Category:</strong> {{ x.category }}\r\n    </p>\r\n\r\n    <p>\r\n        <strong>Amount:</strong> {{ x.amount }}\r\n    </p>\r\n\r\n    <p>\r\n        <strong>Vendor:</strong> {{ x.vendor }}\r\n    </p>\r\n</div>\r\n\r\n{% endfor %}\r\n\r\n\r\n<div class=\"total-amount\">\r\n    Total Amount:\r\n    {{ doc.total_amount }}\r\n</div>\r\n\r\n<p>\r\n    <strong>Remaining Budget at Submission:</strong>\r\n    {{ doc.remaining_budget_at_submission }}\r\n</p>\r\n{% if doc.print_summary %}\r\n    <p>\r\n        <strong>Summary:</strong>\r\n        {{ doc.print_summary }}\r\n    </p>\r\n{% endif %}\r\n",
